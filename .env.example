
# ==============================
# BREWLITE - ENVIRONMENT CONFIG
# ==============================

# PostgreSQL
POSTGRES_DB=brewlite
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite_dev_password
POSTGRES_PORT=5432

# NestJS Backend
API_PORT=3001
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=brewlite
DATABASE_USER=brewlite
DATABASE_PASSWORD=brewlite_dev_password

# Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://api:3001

# Application
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# JWT - local development only
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
