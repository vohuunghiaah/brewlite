# ==============================================================================
# BREWLITE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Sao chép tệp này thành .env cho môi trường chạy cục bộ:
# cp .env.example .env
# ==============================================================================

# --- Môi trường chung ---
NODE_ENV=development

# --- Backend API (apps/api) ---
PORT=4000
DATABASE_URL="postgresql://brewlite:brewlite@localhost:5432/brewlite?schema=public"
JWT_SECRET="brewlite-super-secret-jwt-key-2026-minimum-32-chars-long"
JWT_EXPIRES_IN="7d"

# --- Frontend Client (apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
PORT=3000
