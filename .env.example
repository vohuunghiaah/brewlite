# ==============================================================================
# BREWLITE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Sao chép tệp này thành .env cho môi trường chạy cục bộ:
# cp .env.example .env
# ==============================================================================

# --- Môi trường chung (Application Environment) ---
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Cơ sở dữ liệu PostgreSQL (Database Configuration) ---
POSTGRES_DB=brewlite
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite_dev_password
POSTGRES_PORT=5432
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=brewlite
DATABASE_USER=brewlite
DATABASE_PASSWORD=brewlite_dev_password
# Prisma Connection String (dùng cho apps/api)
DATABASE_URL="postgresql://brewlite:brewlite_dev_password@localhost:5432/brewlite?schema=public"

# --- Backend API (apps/api - NestJS) ---
PORT=4000
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- JSON Web Token (Bảo mật xác thực) ---
# Tối thiểu 32 ký tự theo chuẩn OWASP
JWT_SECRET=brewlite-super-secret-jwt-key-2026-minimum-32-chars-long
JWT_EXPIRES_IN=7d

# --- Frontend Client (apps/web - Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
API_INTERNAL_URL=http://api:4000/api
