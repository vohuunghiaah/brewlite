@startuml
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam defaultTextAlignment center
skinparam roundCorner 8
skinparam wrapWidth 260

' Palette
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #455A64
  BorderThickness 1.5
}
skinparam artifact {
  BackgroundColor #F5F5F5
  BorderColor #546E7A
}
skinparam database {
  BackgroundColor #E8EAF6
  BorderColor #3F51B5
}
skinparam cloud {
  BackgroundColor #FAFAFA
  BorderColor #9E9E9E
}

title Deployment Diagram - Hệ Thống BrewLite (Task 3.2)\nPhân Định Ranh Giới: Local Development, CI/CD Pipeline & Target Production

' ============================================================================
' 1. LOCAL DEVELOPMENT ENVIRONMENT (LIVE / VERIFIED)
' ============================================================================
package "1. Môi Trường Phát Triển Cục Bộ (Local Development)\n[TRẠNG THÁI: LIVE / ĐÃ KIỂM CHỨNG BẰNG DOCKER COMPOSE]" #F3E5F5 {
  node "Máy Trạm Lập Trình Viên (Developer Workstation)\n<<Device: PC / Laptop>>" as LocalWorkstation {

    artifact ".env\n<<Configuration>>\nBiến môi trường cục bộ\n(PORT, DB credentials...)" as LocalEnv

    node "Docker Engine / Desktop\n<<Execution Environment>>" as LocalDocker {

      node "Container: brewlite-web\n<<Container>>" as LocalWebContainer {
        artifact "Next.js Dev Server\n<<Artifact: Node.js 24>>\nCổng: :3000" as LocalWebArtifact
      }

      node "Container: brewlite-api\n<<Container>>" as LocalApiContainer {
        artifact "NestJS Modular API\n<<Artifact: Node.js 24>>\nCổng: :3001" as LocalApiArtifact
      }

      node "Container: brewlite-db\n<<Container>>" as LocalDbContainer {
        database "PostgreSQL 16 Engine\n<<DBMS>>\nCổng: :5432" as LocalPgEngine
      }

      storage "Docker Named Volume\n<<Storage Volume>>\npostgres_data" as LocalVolume
    }
  }
}

' ============================================================================
' 2. CI/CD AUTOMATION ENVIRONMENT (LIVE / HOSTED GITHUB ACTIONS)
' ============================================================================
package "2. Môi Trường Tự Động Hóa CI/CD (GitHub Platform)\n[TRẠNG THÁI: LIVE / HOSTED CI RUNNING]" #FFF3E0 {

  node "Dịch Vụ Lưu Trữ Mã Nguồn (GitHub Repository)\n<<VCS: github.com/vohuunghiaah/brewlite>>" as GitHubRepo {
    artifact "Mã nguồn ứng dụng\n(Next.js & NestJS)" as GitSource
    artifact "Cấu hình Dockerfile\n& docker-compose.yml" as GitDockerfiles
    artifact "Quality Gates Workflow\n(.github/workflows/quality.yml)" as GitWorkflow
  }

  node "GitHub Actions Hosted Runner\n<<Virtual Machine: Ubuntu Latest (22.04/24.04)>>" as CiRunner {
    node "CI Execution Environment\n<<Runtime: Node.js 24.x>>" as CiNode {
      artifact "Quality Gate: API\n(Install -> Oxlint -> Jest -> Build)" as CiApiJob
      artifact "Quality Gate: Web\n(Install -> ESLint -> Test -> Build)" as CiWebJob
    }
  }

  node "GitHub Packages / Registry\n<<Container Registry: ghcr.io>>" as ContainerRegistry {
    artifact "Docker Image Target\n<<Image: brewlite-api:tag>>" as ApiImage
    artifact "Docker Image Target\n<<Image: brewlite-web:tag>>" as WebImage
  }
}

' ============================================================================
' 3. TARGET PRODUCTION DEPLOYMENT ENVIRONMENT (PROPOSED / NOT LIVE DEPLOYED)
' ============================================================================
cloud "3. Môi Trường Triển Khai Production Mục Tiêu (Target Cloud Platform)\n[TRẠNG THÁI: PROPOSED / CHƯA TRIỂN KHAI LIVE TRÊN CLOUD]" #E3F2FD {

  note as ProdNote #FFFDE7
    <b>LƯU Ý NGHIỆM THU KIẾN TRÚC:</b>
    Hệ thống chưa triển khai thực tế trên Cloud Production.
    Nền tảng Cloud (Vercel, Railway, Render, AWS ECS) đang ở trạng thái
    <b>ĐỀ XUẤT (PROPOSED)</b>, chờ quyết định phê duyệt nền tảng chính thức.
    Sơ đồ này mô tả <b>Kiến Trúc Triển Khai Mục Tiêu (Target Deployment)</b>.
  end note

  node "Thiết Bị Khách Hàng (Customer Client)\n<<Device: Smartphone / Tablet / PC>>" as ProdClient {
    artifact "Trình Duyệt Web Hiện Đại / PWA\n<<Client Artifact>>\n(Chrome, Safari, Edge)" as ProdBrowser
  }

  node "Cụm Máy Chủ Frontend (Frontend Edge Hosting)\n<<PaaS / CDN Edge Node: Vercel / Cloudflare>>" as ProdFrontendNode {
    artifact "Next.js 16 Production Build\n<<Artifact: SSR & Static Cache>>\nLắng nghe: HTTPS (Cổng 443)" as ProdNextArtifact
  }

  node "Cụm Máy Chủ Backend (Application Cloud Service)\n<<Container Service: Managed PaaS / AWS ECS>>" as ProdBackendNode {

    node "Docker Production Container\n<<Container: Alpine Linux (Node.js 24)>>" as ProdApiContainer {
      artifact "NestJS Production API\n<<Artifact: dist/main.js>>\nLắng nghe: HTTP (:3001) / HTTPS (:443)" as ProdApiArtifact
      artifact "Endpoint Giám Sát\n<<Endpoint: GET /health>>\n(GAP-04 Target)" as ProdHealthProbe
      artifact "Dòng Nhật Ký Vận Hành\n<<Logging: stdout / JSON Stream>>\n(NestJS Logger / Winston)" as ProdLogs
      artifact "Dịch Vụ Thanh Toán Giả Lập\n<<Mock Payment Service>>\n(ADR-003 Sandbox)" as ProdMockPayment
    }

    artifact "Cấu Hình Bí Mật (Cloud Secrets Manager)\n<<Environment Variables>>\nDATABASE_URL, JWT_SECRET, NODE_ENV..." as ProdSecrets
  }

  database "Cụm Cơ Sở Dữ Liệu Quản Trị (Managed Database)\n<<DBaaS: Managed PostgreSQL 16>>" as ProdDbNode {
    artifact "PostgreSQL Instance\n<<RDBMS Engine>>\nLắng nghe: TCP (:5432)" as ProdPgEngine
    storage "Ổ Lưu Trữ Bền Vững Mã Hóa\n<<Encrypted SSD Volume>>\n(Data Persistence & Daily Backups)" as ProdPersistentStorage
  }
}

' ============================================================================
' MỐI QUAN HỆ & LUỒNG GIAO TIẾP (CONNECTIONS & PROTOCOLS)
' ============================================================================

' 1. Luồng Local
LocalWebArtifact --> LocalApiArtifact : HTTP REST\n(localhost:3001)\nJSON Payload
LocalApiArtifact --> LocalPgEngine : TCP (Cổng 5432)\nTypeORM Connection Pool
LocalPgEngine --> LocalVolume : File I/O\n(Ghi nhận dữ liệu bền vững)
LocalEnv ..> LocalWebContainer : Nạp biến môi trường
LocalEnv ..> LocalApiContainer : Nạp biến môi trường

' 2. Luồng CI/CD
LocalWorkstation --> GitHubRepo : Git Push (SSH / HTTPS 443)\nNhánh: main, feature/*
GitSource --> CiRunner : Kích hoạt workflow tự động\n(Event: push, pull_request)
GitWorkflow --> CiRunner : Chỉ định kịch bản kiểm thử
CiRunner --> ContainerRegistry : Đóng gói & Push Image\n(Target Release Pipeline)

' 3. Luồng Production Mục Tiêu
ProdBrowser --> ProdFrontendNode : HTTPS (Cổng 443)\nTLS 1.3 / HTTP/2\nGiao diện Next.js
ProdBrowser --> ProdBackendNode : HTTPS (Cổng 443)\nREST API JSON Requests\n(CORS Whitelist, Bearer JWT)
ProdFrontendNode --> ProdBackendNode : Server-Side Fetch\n(BFF Pattern / Proxy)
ProdApiArtifact --> ProdPgEngine : TCP / TLS Encrypted (Cổng 5432)\nConnection Pool (Prisma/TypeORM)
ProdPgEngine --> ProdPersistentStorage : Block Storage I/O\n(ACID Wal & Data Files)
ProdSecrets ..> ProdBackendNode : Tiêm biến môi trường\nRuntime Injection

@enduml
