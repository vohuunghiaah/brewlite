@startuml
!pragma layout smetana
title BrewLite — cấu hình triển khai và luồng phát hành
skinparam shadowing false
actor Customer
node "Browser / mobile" as browser
Customer --> browser
frame "LOCAL · Docker Desktop" {
  node "web :3000" as lw
  node "api :3001\nGET /health" as la
  database "db :5432\nPostgreSQL 16" as ld
  storage "postgres_data" as lv
  lw --> la : Internal HTTP
  la --> ld : TCP
  ld --> lv
}
browser --> lw : localhost:3000
browser --> la : localhost:3001
frame "CI · GitHub Actions" {
  component "quality.yml\nlint, tests, builds, ephemeral Compose" as quality
  component "deploy.yml\nquality gate + build/push" as cd
}
cloud "GHCR\nweb / api images" as ghcr
cd --> ghcr : HTTPS publish
node "AWS Lightsail · Docker Engine" {
  node "Caddy\npublic 80 / 443" as proxy
  node "web:3000\nNext.js" as web
  node "api:3001\nNestJS + mock gateway\n/health checks database" as api
  database "db:5432\nPostgreSQL 16" as db
  storage "postgres_data" as vol
  storage "caddy_data / caddy_config" as tls
  artifact "Production environment\nDB credentials, JWT, domain" as env
  artifact "Docker json-file logs\n10 MB × 3" as logs
  component "rollout-production.sh\nbackup, pull, migrate, smoke / rollback" as rollout
  proxy --> web : internal HTTP
  proxy --> api : /api/* strips prefix
  proxy --> tls
  api --> db : internal TCP
  db --> vol
  env ..> api
  env ..> db
  api ..> logs
  rollout ..> api
}
browser --> proxy : HTTPS 443
cd --> rollout : approved production job / SSH
rollout --> ghcr : pull selected images
@enduml
