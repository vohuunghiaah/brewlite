@startuml
title BrewLite — UC-04: Đặt hàng
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam backgroundColor white
skinparam shadowing false
skinparam ActivityBackgroundColor white
skinparam ActivityBorderColor #333333
skinparam ActivityDiamondBackgroundColor white
skinparam ActivityDiamondBorderColor #333333
skinparam wrapWidth 315
|Khách hàng|
start
:Xem giỏ hàng và xác nhận đặt hàng;
|Frontend|
:Kiểm tra giỏ hàng;
if () then ([Giỏ không hợp lệ])
:Hiển thị lỗi, giữ giỏ để điều chỉnh;
stop
else ([Giỏ hợp lệ])
endif
if () then ([Chưa đăng nhập])
:Giữ giỏ và mở màn hình đăng nhập;
|Khách hàng|
:Nhập tài khoản và mật khẩu;
|Backend|
:Xác thực tài khoản;
if () then ([Xác thực thất bại])
:Trả lỗi xác thực;
|Frontend|
:Nhận lỗi, hiển thị thông báo và giữ giỏ hàng;
stop
else ([Xác thực thành công])
endif
|Frontend|
:Trở lại checkout với JWT;
else ([Đã đăng nhập])
endif
:Gửi POST /orders kèm JWT và giỏ hàng;
|Backend|
:Kiểm tra JWT và dữ liệu đầu vào;
if () then ([Yêu cầu sai])
:Trả lỗi 400 / 401;
|Frontend|
:Nhận lỗi, hiển thị thông báo và giữ giỏ;
stop
else ([Yêu cầu hợp lệ])
endif
|Backend|
:BEGIN TX1 — yêu cầu đọc giá và tồn kho;
|PostgreSQL|
:Đọc giá và tồn kho;
|Backend|
:Kiểm tra khả dụng và tính lại tổng tiền;
if () then ([Thiếu hàng])
:ROLLBACK TX1 và trả HTTP 400;
|Frontend|
:Nhận lỗi, hiển thị hết hàng và giữ giỏ;
stop
else ([Đủ hàng])
endif
|Backend|
:Yêu cầu tạo đơn trong TX1;
|PostgreSQL|
:Lưu Order và OrderItem ở PENDING;
if () then ([Lỗi ghi đơn])
:ROLLBACK TX1;
|Backend|
:Trả lỗi ghi đơn;
|Frontend|
:Nhận lỗi, hiển thị thông báo và giữ giỏ;
stop
else ([Đã lưu đơn])
endif
|PostgreSQL|
:COMMIT TX1;
|Backend|
:Trả 201 Created với Order PENDING;
|Frontend|
if () then ([Mất phản hồi sau COMMIT])
:Thông báo kết quả chưa xác định, giữ giỏ
Không tự động gửi lại POST /orders
GAP-05: tra cứu đơn của chính khách chỉ hỗ trợ khôi phục;
stop
else ([Nhận phản hồi])
endif
:Nhận id (số nguyên), totalAmount và PENDING;
:Hiển thị tạo đơn thành công\nChưa thanh toán; chưa được pha chế;
stop
@enduml
