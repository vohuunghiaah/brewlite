---
classDiagram
  direction TB
  %% Official Task 2.3 domain view; SRS 1.4.0 / UC-04 / UC-10.
  %% Customer/Staff are conceptual roles, not implemented subclasses.
  %% Menu is a view of existing products (FR-01), not a new persistent entity.
  class User {
    <<IMPLEMENTED>>
    id
    createdAt
    email
  }
  class Customer {
    <<CONCEPTUAL>>
    loyaltyPoints
    placeOrder()
  }
  class Staff {
    <<DEFERRED>>
    updateOrderStatus()
  }
  class Order {
    <<IMPLEMENTED>>
    id
    orderCode
    status
    totalAmount
  }
  class OrderItem {
    <<IMPLEMENTED>>
    quantity
    size
    toppings
    unitPrice
  }
  class Product {
    <<IMPLEMENTED>>
    name
    price
    isAvailable
    stock
    version
  }
  class Payment {
    <<IMPLEMENTED>>
    amount
    status
    method
    idempotencyKey
  }
  class Menu {
    <<CONCEPTUAL>>
    viewProducts()
  }

  class Promotion {
    <<DEFERRED>>
    code
    discountType
    discountValue
    minOrderValue
    isActive
  }
  class LoyaltyTransaction {
    <<DEFERRED>>
    id
    points
    type
    createdAt
  }
  class OrderStatus {
    <<enumeration>>
    PENDING
    PAID
    PAYMENT_FAILED
    PREPARING
    READY
    COMPLETED
    CANCELLED
  }
  class PaymentStatus {
    <<enumeration>>
    PENDING
    SUCCESS
    FAILED
    REFUND_PENDING
    REFUNDED
  }

  User <|-- Customer
  User <|-- Staff
  Customer "1" -- "0..*" Order : places
  Staff -- Order : updates paid orders
  Order "1" *-- "1..*" OrderItem : contains
  %% Multiple attempts do not permit multiple successful settlements of one Order.
  Order "1" -- "0..*" Payment : payment attempts
  OrderItem "0..*" -- "1" Product : references
  Menu o-- "0..*" Product : lists
  %% Promotion is linked by promoCode in the reference schema, not an ORM FK.
  Promotion "0..1" -- "0..*" Order : applied to
  User "1" -- "0..*" LoyaltyTransaction : owns ledger
  Order "0..1" -- "0..*" LoyaltyTransaction : referenced by
  OrderStatus <.. Order : status
  Payment ..> PaymentStatus : status
  %% Refund states implemented by PaymentsService; loyalty ledger deferred.
  %% Staff assignment and number of Menu views are unspecified, not DB cardinalities.
