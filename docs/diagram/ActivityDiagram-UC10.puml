@startuml
title BrewLite — UC-10: Thanh toán không tiền mặt
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam backgroundColor white
skinparam shadowing false
skinparam ActivityBackgroundColor white
skinparam ActivityBorderColor #333333
skinparam ActivityDiamondBackgroundColor white
skinparam ActivityDiamondBorderColor #333333
skinparam wrapWidth 315

|Khách hàng|
|Frontend|
|Backend|
|PostgreSQL|
|Thanh toán mô phỏng|
|Backend|
start
:Tiếp nhận một sự kiện kích hoạt
Mỗi lượt chỉ thực hiện một nhánh;
note right #white
  Thiết kế mục tiêu (GAP-01/GAP-02).
  Ba nhánh là các lượt độc lập,
  không tự khởi chạy đồng thời.
end note
if () then ([Yêu cầu thanh toán])
|Khách hàng|
:Chọn thanh toán đơn đã tồn tại\nChọn Ví/Thẻ và xác nhận;
|Frontend|
:Tạo khóa mới cho lần thanh toán mới\nGửi lại cùng yêu cầu giữ khóa và payload;
:Gửi POST /payments\nJWT, orderId, amount, method, Idempotency-Key;
|Backend|
:Kiểm tra JWT, quyền sở hữu, số tiền và dữ liệu;
if () then ([Không hợp lệ])
  :Trả lỗi, giữ đơn đã tồn tại;
  |Frontend|
  :Nhận lỗi và hiển thị thông báo\nGiữ thông tin đơn;
  stop
else ([Hợp lệ])
endif
|PostgreSQL|
:Tra cứu khóa theo chủ sở hữu\nĐối chiếu orderId, amount, method;
|Backend|
if () then ([Cùng khóa, payload khác])
  :Trả 409, từ chối yêu cầu;
  |Frontend|
  :Nhận lỗi và hiển thị thông báo\nGiữ thông tin đơn;
  stop
else ([Khóa mới hoặc payload khớp])
endif
|Backend|
if () then ([Khóa đã tồn tại])
  :Trả kết quả/trạng thái đã lưu\nKhông thu tiền hoặc trừ kho lần nữa;
  |Frontend|
  :Hiển thị trạng thái đã nhận\nChỉ xóa giỏ nếu PAID;
  stop
else ([Khóa mới])
endif
|PostgreSQL|
:Kiểm tra trạng thái và cấp quyền xử lý nguyên tử;
|Backend|
if () then ([Không được phép])
  :Từ chối đơn PAID/CANCELLED hoặc giao dịch\nđang xử lý, PENDING chưa đối soát,\nREFUND_PENDING/REFUNDED;
  |Frontend|
  :Nhận từ chối, hiển thị trạng thái và giữ đơn;
  stop
else ([Đơn PENDING/PAYMENT_FAILED hợp lệ])
endif
|PostgreSQL|
:COMMIT attempt PENDING, merchantReference,\nchủ sở hữu, orderId, amount, method,\nkhóa/payload và công việc đối soát;
if () then ([Lỗi lưu])
  |Backend|
  :Trả lỗi, chưa gọi Payment Service;
  |Frontend|
  :Nhận lỗi và hiển thị thông báo\nGiữ thông tin đơn;
  stop
else ([Đã commit])
endif
|Backend|
:Gửi thanh toán với merchantReference\nvà khóa cố định của attempt;
|Thanh toán mô phỏng|
:Thực hiện thanh toán;
|Backend|
:Nhận kết quả, lưu transactionId nếu có;
if () then ([FAILED])
  |PostgreSQL|
  :Lưu Payment FAILED và Order PAYMENT_FAILED\nKhông trừ kho;
  |Backend|
  :Trả lỗi thanh toán;
  |Frontend|
  :Nhận FAILED, hiển thị lỗi và giữ đơn\nCho phép thanh toán lại khi đủ điều kiện\nLần thanh toán mới dùng khóa mới;
  stop
else ([Khác FAILED])
endif
|Backend|
if () then ([PENDING / timeout])
  |PostgreSQL|
  :Giữ PENDING và lịch đối soát bền vững;
  |Backend|
  :Trả 202 + PENDING, kết thúc HTTP POST;
  |Frontend|
  :Nhận 202 + PENDING\nKết thúc POST /payments;
  stop
else ([SUCCESS])
endif
|Backend|
:Yêu cầu quyết toán trong TX2;
|PostgreSQL|
:BEGIN TX2 — kiểm tra stock/version\nvà trừ kho bằng OCC;
if () then ([Hợp lệ])
  |PostgreSQL|
  :Lưu Payment SUCCESS và Order PAID\nCOMMIT TX2;
|Backend|
:Trả 200 + PAID;
|Frontend|
if () then ([Mất phản hồi])
  :Gửi lại POST /payments\ncùng payload và cùng khóa;
  |Backend|
  :Xác thực, đối chiếu khóa/payload\nTrả kết quả đã lưu hoặc 409 nếu khác;
  |Frontend|
else ([Đã nhận phản hồi])
endif
:Hiển thị kết quả\nChỉ xác nhận PAID và xóa giỏ sau COMMIT TX2;
stop
else ([Xung đột])
endif
|PostgreSQL|
  :ROLLBACK TX2\nOrder và tồn kho giữ nguyên;
  :TX3 — lưu transactionId, refundKey,\nREFUND_PENDING và công việc hoàn tiền;
  :COMMIT TX3;
  if () then ([Lưu TX3 thất bại])
    |Backend|
    :Giữ khóa đang xử lý và công việc đối soát
Khôi phục dữ liệu TX3 trước khi hoàn tiền;
    :Trả lỗi theo API Contract, không xác nhận hoàn tiền;
    |Frontend|
    :Hiển thị kết quả chưa xác định, giữ đơn;
    stop
  else ([TX3 đã commit])
  endif
  |Backend|
  :Yêu cầu hoàn tiền với refundKey đã lưu;
  |Thanh toán mô phỏng|
  :Thử hoàn tiền một lần với refundKey cố định;
note right #white
  Không tăng tồn kho vì TX2 đã rollback.
  Lỗi ghi kết quả: giữ công việc đối soát,
  dùng lại refundKey; chưa báo REFUNDED.
end note
  |Backend|
  if () then ([REFUNDED đã xác nhận])
    |PostgreSQL|
    :Transaction — lưu Payment REFUNDED\nvà Order CANCELLED;
    if () then ([Lỗi ghi kết quả])
      |Backend|
      :Giữ công việc đối soát và refundKey\nTrả kết quả chưa xác định theo API Contract;
      |Frontend|
      :Hiển thị đang chờ xác minh, chưa xác nhận hoàn tiền;
      stop
    else ([Đã commit])
    endif
    |Backend|
  else ([Lỗi / PENDING / timeout])
    |PostgreSQL|
    :Giữ REFUND_PENDING\nLưu lịch hoàn tiền tiếp theo;
  endif
  |Backend|
  :Trả 409 + trạng thái hoàn tiền\nKết thúc POST /payments;
  |Frontend|
  :Nhận kết quả, hiển thị đang hoàn/đã hoàn\nGiữ đơn, không xóa giỏ;
  stop

else ([Không phải yêu cầu thanh toán])
endif
|Backend|
if () then ([Công việc đến hạn])
:Tác vụ nền được kích hoạt bởi công việc đến hạn\nHTTP thanh toán đã kết thúc;
|PostgreSQL|
:Nhận quyền xử lý nguyên tử\nĐọc attempt và trạng thái hiện tại;
|Backend|
if () then ([Đã xử lý hoặc bị khóa])
  :Kết thúc lượt tác vụ, không xử lý trùng;
  stop
else ([Có quyền xử lý])
endif
if () then ([Payment REFUND_PENDING])
  |Thanh toán mô phỏng|
  :Tra cứu/hoàn tiền với cùng refundKey;
  |Backend|
  if () then ([REFUNDED đã xác nhận])
    |PostgreSQL|
    :Transaction — Payment REFUNDED\nvà Order CANCELLED;
    if () then ([Lỗi ghi kết quả])
      |Backend|
      :Giữ công việc đối soát và refundKey\nChưa xác nhận REFUNDED;
      stop
    else ([Đã commit])
    endif
    |Backend|
  else ([Chưa xác nhận])
    |PostgreSQL|
    :Giữ REFUND_PENDING\nLưu lịch thử tiếp với cùng refundKey;
  endif
  |Backend|
  :Kết thúc lượt tác vụ nền\nKết quả được lưu để client đọc sau;
  stop
else ([Payment PENDING])
endif
  |Thanh toán mô phỏng|
  :Tra cứu merchantReference đã lưu\nhoặc transactionId nếu có;
  |Backend|
  if () then ([FAILED đã xác minh])
    |PostgreSQL|
    :Transaction — lưu Payment FAILED\nvà Order PAYMENT_FAILED;
    stop
  else ([Khác FAILED])
  endif
  |Backend|
  if () then ([PENDING / timeout / chưa tìm thấy])
    |PostgreSQL|
    :Giữ PENDING, lưu lịch kiểm tra tiếp;
    stop
  else ([SUCCESS])
  endif
  |Backend|
  :Yêu cầu quyết toán kết quả đối soát trong TX2;
  |PostgreSQL|
  :BEGIN TX2 — kiểm tra trạng thái và OCC\nTrừ kho đúng một lần;
  if () then ([Hợp lệ])
    :Lưu Payment SUCCESS và Order PAID\nCOMMIT TX2;
    stop
  else ([Xung đột])
    :ROLLBACK TX2;
    :TX3 — lưu REFUND_PENDING,\ntransactionId, refundKey và công việc hoàn tiền;
    :COMMIT TX3;
    if () then ([Lưu TX3 thất bại])
      |Backend|
      :Giữ khóa để đối soát\nKhôi phục TX3 trước khi hoàn tiền;
    else ([TX3 đã commit])
      |Backend|
      :Kết thúc lượt, công việc hoàn tiền chờ đến hạn;
    endif
    stop
  endif

else ([Khách yêu cầu xem trạng thái])
endif
|Khách hàng|
:Chọn kiểm tra trạng thái đơn\nhoặc tiếp tục theo dõi;
|Frontend|
:Gửi GET /orders/:id + JWT\nMột lượt HTTP mới, độc lập với tác vụ nền;
|Backend|
:Xác thực JWT và kiểm tra quyền sở hữu;
if () then ([Không có quyền])
  :Trả lỗi quyền truy cập;
  |Frontend|
  :Nhận lỗi và hiển thị thông báo\nGiữ thông tin đơn;
  stop
else ([Có quyền])
endif
|Backend|
:Yêu cầu đọc trạng thái đơn/giao dịch;
|PostgreSQL|
:Đọc Order và Payment đã lưu;
|Backend|
:Trả 200 + trạng thái trong HTTP GET mới;
|Frontend|
:Nhận 200 + trạng thái hiện tại;
if () then ([PAID])
  :Hiển thị thanh toán thành công\nChỉ xóa giỏ khi PAID;
else ([Chưa PAID])
  :Hiển thị PAYMENT_FAILED / PENDING /\nREFUND_PENDING / REFUNDED / CANCELLED\nCho phép thử lại khi đủ điều kiện;
endif
:Kết thúc GET\nLượt kiểm tra tiếp theo là yêu cầu mới;
stop
@enduml
