@startuml brewlite-usecase-place-order
' BrewLite — Task 1.3 — Đặc tả Use Case Chi tiết UC-04 Đặt hàng
' Tài liệu tham chiếu: SRS 1.4.0 và REQ-UC-04 v1.4.0
' UC-04 tạo đơn PENDING; UC-10 thanh toán độc lập trên đơn đã tồn tại.

skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam roundCorner 0
skinparam nodesep 35
skinparam ranksep 35
skinparam usecase {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}
skinparam note {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}
left to right direction

title BREWLITE — TASK 1.3: UC-04 ĐẶT HÀNG (PLACE ORDER)\nUC-10 và Payment Gateway: ngữ cảnh độc lập sau tạo đơn

actor "Khách hàng\n(Customer)" as Customer

rectangle "Hệ Thống BrewLite" {
    usecase "UC-09: Áp dụng\nmã khuyến mãi" as UC9
    usecase "UC-04: Đặt hàng\n(Place Order)" as UC4
    usecase "UC-10: Thanh toán\nkhông tiền mặt" as UC10

    note "UC-04 thành công khi TX1 commit\nOrder PENDING.\nKhách hàng kích hoạt UC-10 độc lập\ntrên đơn đã có.\nĐơn chưa thanh toán chưa được pha chế." as N1
    UC4 -[norank,dashed]- N1
    ' Liên kết ẩn chỉ xếp ba Use Case theo trục dọc.
    UC9 -[hidden]left-> UC4
    UC4 -[hidden]left-> UC10
    UC4 -[hidden]down-> N1
}

actor "Cổng Thanh Toán Mô Phỏng\n(Mock Payment Service)" as PaymentGateway

Customer -[norank]- UC4
Customer -[hidden]down-> UC4
Customer -[norank]- UC10
Customer -[norank]- UC9

UC9 -[dashed,norank]-> UC4 : <color:transparent>..................................................</color><<extend>>

UC10 -- PaymentGateway

@enduml
