@startuml brewlite-system-usecases
' BrewLite — Task 1.2 — Use Case tổng quát
' Bản mô hình nghiệp vụ để xây dựng và đối chiếu SRS ở bước đặc tả.
' UC-CORE-01 là luồng end-to-end được đặc tả riêng.

skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam linetype ortho
skinparam roundCorner 0
skinparam usecase {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}
left to right direction

title BREWLITE — USE CASE TỔNG QUÁT

actor "Khách hàng\n(Customer)" as Customer
actor "Nhân viên quầy\n(Barista)" as Barista
actor "Cổng Thanh Toán\n(Mock Payment)" as PaymentGateway
actor "Hệ thống Giám sát\n(Monitoring)" as Monitor

rectangle "Hệ Thống BrewLite" {
    usecase "UC-01: Xem menu\nđồ uống" as UC1
    usecase "UC-02: Tùy biến\nsize & topping" as UC2
    usecase "UC-03: Quản lý\ngiỏ hàng" as UC3

    usecase "UC-07: Đăng ký\ntài khoản" as UC7
    usecase "UC-08: Đăng nhập\n(JWT)" as UC8
    usecase "UC-11: Tra cứu\nđiểm Loyalty" as UC11

    usecase "UC-04: Đặt hàng\n(Place Order)" as UC4
    usecase "UC-09: Áp dụng\nmã khuyến mãi" as UC9
    usecase "UC-10: Thanh toán\nkhông tiền mặt" as UC10
    usecase "UC-05: Theo dõi\ntrạng thái đơn" as UC5
    usecase "UC-06: Xem lịch sử\nđơn hàng" as UC6

    usecase "UC-12: Cập nhật\ntiến độ pha chế" as UC12
    usecase "UC-13: Kiểm tra\nsức khỏe hệ thống" as UC13
}

' Liên kết actor Khách hàng với các nghiệp vụ trực tiếp sử dụng.
Customer -- UC1
Customer -- UC2
Customer -- UC3
Customer -- UC7
Customer -- UC8
Customer -- UC4
Customer -- UC5
Customer -- UC6
Customer -- UC9
Customer -- UC10
Customer -- UC11

' Quan hệ trong sơ đồ hiện tại, giữ nguyên so với bản trước.
' Cần xác nhận: UC-04 tạo đơn PENDING, UC-10 thanh toán sau đó.
UC4 ..> UC10 : <<include>>
UC9 ..> UC4 : <<extend>>

' Các actor bên ngoài hệ thống
PaymentGateway -- UC10
Barista -- UC12
Monitor -- UC13

@enduml
