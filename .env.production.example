# ==============================================================================
# BrewLite Production Environment Variable Template
# Copy to .env.production on the production host or configure via Secret Manager.
# DO NOT COMMIT ACTUAL VALUES TO VERSION CONTROL.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=brewlite_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_RANDOM_PASSWORD_64_CHARS
POSTGRES_DB=brewlite_prod

# Backend API Configuration
PORT=4000
NODE_ENV=production
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public
JWT_SECRET=CHANGE_ME_TO_CRYPTOGRAPHICALLY_SECURE_KEY_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://brewlite.example.com

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://api.brewlite.example.com
API_INTERNAL_URL=http://api:4000/api
WEB_BIND_PORT=3000
API_BIND_PORT=4000

# Container Image Tag (for CD automation)
IMAGE_TAG=latest

