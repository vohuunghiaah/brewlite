{
  "info": {
    "name": "BrewLite ASM2 LOCAL",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "if (pm.environment.get('baseUrl') !== 'http://localhost:3001') { pm.execution.skipRequest(); throw new Error('Select BrewLite LOCAL'); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Welcome",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Database readiness",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test('Response contract', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d).to.eql({status:'ok', database:'up'});",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Select catalog fixtures",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test('Response contract', () => {",
                  "  const d = pm.response.json();",
                  "  const p = d.find(p => p.isAvailable && p.stock > 0);",
                  "  pm.environment.set('productId', p.id);",
                  "  pm.environment.set('initialStock', p.stock);",
                  "  pm.environment.set('unavailableId', d.find(p => p.stock === 0).id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Product detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/{{productId}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test('Response contract', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.id).to.eql(Number(pm.environment.get('productId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unavailable product",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/{{unavailableId}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test('Response contract', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.stock).to.eql(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing product",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/2147483647",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
                  "pm.test('Response contract', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.message).to.exist;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('email', 'audit-'+pm.variables.replaceIn('{{$guid}}')+'@example.test');",
                  "pm.environment.set('password', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"WrongPassword\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
                  "pm.test('Response contract', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.message).to.exist;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test('Response contract', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.accessToken.split('.').length).to.eql(3);",
                  "  pm.environment.set('accessToken', d.accessToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test('Response contract', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.email).to.eql(pm.environment.get('email'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
