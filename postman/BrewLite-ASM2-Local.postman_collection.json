            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"other-{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test('Response contract', () => {",
                  "  const d = pm.response.json();",
                  "  pm.environment.set('otherToken', d.accessToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Other owner denied",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/{{orderId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
                  "pm.test('Response contract', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.message).to.exist;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Catalog administration",
      "item": [
        {
          "name": "Create fixture",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/products",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Catalog-Admin-Key",
                "value": "{{catalogKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Runner fixture\",\n  \"price\": \"12000\",\n  \"stock\": 2\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test('Response contract', () => {",
                  "  const d = pm.response.json();",
                  "  pm.environment.set('fixtureId', d.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update fixture",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/products/{{fixtureId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Catalog-Admin-Key",
                "value": "{{catalogKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test('Response contract', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.stock).to.eql(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete fixture",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/products/{{fixtureId}}",
            "header": [
              {
                "key": "X-Catalog-Admin-Key",
                "value": "{{catalogKey}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test('Response contract', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.message).to.be.a('string');",
                  "  pm.environment.unset('fixtureId');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
