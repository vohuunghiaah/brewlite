{
  "name": "brewlite-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "start:api": "npm run start:dev --workspace=apps/api",
    "start:web": "npm run dev --workspace=apps/web"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}

